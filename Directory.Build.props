<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <StablePackageVersion>0.1.4</StablePackageVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.3</PackageValidationBaselineVersion>
    <LocalPackageVersionPrefix>$(StablePackageVersion)</LocalPackageVersionPrefix>
    <LocalPackageBuildNumber Condition="'$(LocalPackageBuildNumber)' == ''">0</LocalPackageBuildNumber>
    <UseLocalPackageVersion Condition="'$(UseLocalPackageVersion)' == ''">false</UseLocalPackageVersion>
    <PackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</PackageVersion>
    <PackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>$(StablePackageVersion)</AssemblyVersion>
    <FileVersion>$(StablePackageVersion)</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <AIKernelContractPackageVersion Condition="'$(AIKernelContractPackageVersion)' == '' and '$(UseLocalPackageVersion)' == 'true'">[$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)]</AIKernelContractPackageVersion>
    <AIKernelContractPackageVersion Condition="'$(AIKernelContractPackageVersion)' == ''">[$(StablePackageVersion)]</AIKernelContractPackageVersion>
    <AIKernelCorePackageVersion Condition="'$(AIKernelCorePackageVersion)' == '' and '$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelCorePackageVersion>
    <AIKernelCorePackageVersion Condition="'$(AIKernelCorePackageVersion)' == ''">$(StablePackageVersion)</AIKernelCorePackageVersion>
    <AIKernelControlPackageVersion Condition="'$(AIKernelControlPackageVersion)' == '' and '$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelControlPackageVersion>
    <AIKernelControlPackageVersion Condition="'$(AIKernelControlPackageVersion)' == ''">$(StablePackageVersion)</AIKernelControlPackageVersion>
    <AIKernelPackageVersion Condition="'$(AIKernelPackageVersion)' == ''">$(AIKernelContractPackageVersion)</AIKernelPackageVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>Takuya Sogawa</Authors>
    <Company>AIKernel-NET</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://www.nuget.org/profiles/AIKernel-NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIKernel-NET/AIKernel.Providers</RepositoryUrl>
    <Copyright>Copyright © 2026 Takuya Sogawa of AIKernel-NET</Copyright>
    <PackageTags>aikernel;providers;official-provider-set;openai;microsoft-ai;cuda;cpu-compute;filesystem;logging;process-supervisor;event-bus;network;scheduler;profiler;local-llm;chat-history;pipeline-compiler;semantic-runtime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <Description>Official AIKernel extension provider. See the repository release notes and NuGet dependencies for this package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)README-ja.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)RELEASE_NOTES.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)assets\aikernel-logo128x128.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="GenerateProviderBuildVersion" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)ProviderBuildVersion.g.cs"
                      Lines="namespace AIKernel.Providers%3B internal static class ProviderBuildVersion { internal const string Value = &quot;$(PackageVersion)&quot;%3B }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ProviderBuildVersion.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)ProviderBuildVersion.g.cs" />
    </ItemGroup>
  </Target>
  <!-- Opt-in development builds may use Common from the adjacent source checkout. -->
  <PropertyGroup Condition="'$(AIKernelCommonSourceProject)' == '' and '$(UseLocalPackageVersion)' == 'true'">
    <AIKernelCommonSourceProject Condition="Exists('$(MSBuildThisFileDirectory)../AIKernel.Core/src/AIKernel.Common/AIKernel.Common.csproj')">$(MSBuildThisFileDirectory)../AIKernel.Core/src/AIKernel.Common/AIKernel.Common.csproj</AIKernelCommonSourceProject>
  </PropertyGroup>
</Project>
