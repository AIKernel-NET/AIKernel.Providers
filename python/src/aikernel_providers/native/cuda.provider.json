{
  "providerId": "cuda.compute",
  "name": "CUDA Compute",
  "version": "0.1.3",
  "assembly": "CudaComputeProvider.dll",
  "capabilities": [
    "compute.dispatch",
    "compute.vector_add",
    "tensor.matmul",
    "tensor.softmax",
    "tensor.conv2d",
    "tensor.layernorm"
  ],
  "metadata": {
    "adapter_profile": "cuda13",
    "aot_compiler_hooks": "planned-gpu-native-execution",
    "backend": "cuda13.0",
    "deterministic_frame_sampling": "host-frame-token-sample-ticks",
    "fallback": "fail-closed",
    "deviceProfile": "cuda13",
    "entryPoint": "libtorch_bridge",
    "loaderJson": "rom://providers/cuda/loader.json",
    "nativeModuleRef": "aikernel-cuda://cuda13.0/modules/libtorch_bridge",
    "gpu_bypass": "native-cuda-buffer-dispatch",
    "native_js_bridge": "not-required-native-provider",
    "pass_bridge": "native-abi",
    "providerType": "AIKernel.Providers.CudaCompute.CudaComputeProvider",
    "invokerType": "AIKernel.Providers.CudaCompute.CudaComputeInvoker",
    "raw_capture_source": "none",
    "rev3": "true",
    "zero_copy_buffer_handling": "native-cuda-device-buffer"
  },
  "cli": {
    "command": "cuda",
    "defaultOperation": "tensor.matmul",
    "configKeys": [
      "deviceProfile",
      "entryPoint",
      "loaderJson",
      "artifactHash"
    ],
    "requiredEnvironment": []
  }
}
