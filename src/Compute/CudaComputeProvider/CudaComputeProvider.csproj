<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>AIKernel.Providers.CudaCompute</Title>
    <PackageId>AIKernel.Providers.CudaCompute</PackageId>
    <Description>EN: Official AIKernel.NET extension provider for native CUDA compute modules.

JA: Native CUDA compute module を AIKernel 上で扱うための AIKernel.NET 公式拡張 Provider です。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Common" Version="[$(AIKernelCorePackageVersion)]" />
    <PackageReference Include="AIKernel.Core" Version="[$(AIKernelCorePackageVersion)]" />
    <PackageReference Include="AIKernel.Abstractions" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="AIKernel.Dtos" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="AIKernel.Enums" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIKernel.Providers.Compute\AIKernel.Providers.Compute.csproj" />
    <ProjectReference Include="..\..\ProviderSubstrate\AIKernel.Providers.Substrate\AIKernel.Providers.Substrate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="cuda.provider.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="providers\" />
  </ItemGroup>
</Project>
