<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AIKernel.Providers.Cosmos</PackageId>
    <Version>0.1.4-dev12</Version>
    <PackageVersion>0.1.4-dev12</PackageVersion>
    <InformationalVersion>0.1.4-dev12</InformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>COSMOS_SCENE_P0.md</PackageReadmeFile>
    <PackageReleaseNotes>Reject stopped SceneService operations and closed journal access. Preserve successor snapshots, physical-work flags, checkpoints and writer leases. Share shutdown completion across callers; late probes cannot restore readiness. Retain cancellation and existing error allowlists, Scene v1, journal v1 and 0.1.3-dev1 dependencies. Do not downgrade with a recovery checkpoint present. Real deployment acceptance is pending.</PackageReleaseNotes>
    <Description>Optional, authenticated scene observation jobs and NVIDIA Cosmos Reasoner transport. Does not execute proposed actions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Abstractions" Version="[0.1.3-dev1]" />
    <PackageReference Include="AIKernel.Dtos" Version="[0.1.3-dev1]" />
    <PackageReference Include="AIKernel.Enums" Version="[0.1.3-dev1]" />
    <None Include="schemas/*.json" Pack="true" PackagePath="schemas" />
    <None Include="../../../docs/operations/COSMOS_SCENE_P0.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/operations/COSMOS_SCENE_ERRORS.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
