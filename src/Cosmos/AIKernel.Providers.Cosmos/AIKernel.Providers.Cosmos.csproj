<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AIKernel.Providers.Cosmos</PackageId>
    <Version>0.1.4-dev13</Version>
    <PackageVersion>0.1.4-dev13</PackageVersion>
    <InformationalVersion>0.1.4-dev13</InformationalVersion>
    <!-- First release of this package; there is no baseline package on NuGet. -->
    <PackageValidationBaselineVersion />
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>COSMOS_SCENE_P0.md</PackageReadmeFile>
    <PackageReleaseNotes>Contain host clock failures in the readiness error path. Return probe_failed without private details, preserve cancellation type/task state/caller token, revoke cached approval before fallback clock reads and retain stopped/quarantined state. Healthy-clock failure bytes, hash formulas, Scene v1, journal formats remain unchanged. Real deployment acceptance is pending.</PackageReleaseNotes>
    <Description>Optional, authenticated scene observation jobs and NVIDIA Cosmos Reasoner transport. Does not execute proposed actions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="schemas/*.json" Pack="true" PackagePath="schemas" />
    <None Include="../../../docs/operations/COSMOS_SCENE_P0.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/operations/COSMOS_SCENE_ERRORS.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../SharedContracts.props" />
</Project>
