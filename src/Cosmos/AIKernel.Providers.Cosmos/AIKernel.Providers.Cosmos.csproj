    <None Include="schemas/*.json" Pack="true" PackagePath="schemas" />
    <None Include="../../../docs/operations/COSMOS_SCENE_P0.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/operations/COSMOS_SCENE_ERRORS.md" Pack="true" PackagePath="/" />
  </ItemGroup>
