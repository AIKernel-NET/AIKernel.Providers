{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "scene-analysis.v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "sessionEpoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "queued",
        "running",
        "completed",
        "canceled",
        "timed_out",
        "superseded",
        "rejected",
        "failed",
        "interrupted"
      ]
    },
    "analysisOnly": {
      "type": "boolean",
      "const": true
    },
    "freshnessVerified": {
      "type": "boolean"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0
    },
    "layoutRevision": {
      "type": "integer",
      "minimum": 0
    },
    "cameraId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "policyRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "capturedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "targetId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "unknown",
              "no_issue",
              "attention_target_mismatch",
              "target_not_visible",
              "occlusion",
              "overlap",
              "motion_observed",
              "activity_mismatch",
              "visual_anomaly"
            ]
          },
          "unknown": {
            "type": "boolean"
          },
          "evidenceFrameIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "region": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "default": null
          }
        },
        "required": [
          "observationId",
          "actorId",
          "targetId",
          "reasonCode",
          "unknown",
          "evidenceFrameIds"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "actorId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "assetRevision": {
            "type": "integer",
            "minimum": 0
          },
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "targetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "proposalId",
          "actorId",
          "assetRevision",
          "actionId",
          "targetId",
          "observationIds",
          "expiresAtUtc"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "provider": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "endpointId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "gpuIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isMock": {
          "type": "boolean"
        },
        "imageDigest": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "backend",
        "model",
        "revision",
        "precision",
        "runtime",
        "endpointId",
        "gpuIds",
        "isMock"
      ],
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "properties": {
        "queueMs": {
          "type": "number"
        },
        "preparationMs": {
          "type": "number"
        },
        "inferenceMs": {
          "type": "number"
        },
        "validationMs": {
          "type": "number"
        },
        "observationAgeMs": {
          "type": "number"
        }
      },
      "required": [
        "queueMs",
        "preparationMs",
        "inferenceMs",
        "validationMs",
        "observationAgeMs"
      ],
      "additionalProperties": false
    },
    "backendCancellation": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "unsupported",
        "confirmed",
        "unconfirmed"
      ]
    },
    "mode": {
      "type": "string",
      "default": "shadow",
      "enum": [
        "shadow",
        "observe-only",
        "propose"
      ]
    },
    "retryAfterMs": {
      "type": [
        "integer",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "sessionEpoch",
    "snapshotId",
    "status",
    "analysisOnly",
    "freshnessVerified",
    "errorCode",
    "sceneRevision",
    "layoutRevision",
    "cameraId",
    "policyRevision",
    "capturedAtUtc",
    "expiresAtUtc",
    "observations",
    "proposals",
    "provider",
    "timings",
    "backendCancellation"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aikernel:cosmos:scene-v1:result",
  "description": "Wire shape. Cross-field authorization, catalog, snapshot, duplicate keys, byte limits and configured limits are additionally enforced by SceneService. See COSMOS_SCENE_P0.md."
}
