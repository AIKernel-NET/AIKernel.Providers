{
  "type": "object",
  "properties": {
    "snapshot": {
      "type": "object",
      "properties": {
        "sessionEpoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "captureSource": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "capturedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "sceneRevision": {
          "type": "integer",
          "minimum": 0
        },
        "layoutRevision": {
          "type": "integer",
          "minimum": 0
        },
        "cameraId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        }
      },
      "required": [
        "sessionEpoch",
        "snapshotId",
        "captureSource",
        "capturedAtUtc",
        "sceneRevision",
        "layoutRevision",
        "cameraId"
      ],
      "additionalProperties": false
    },
    "frameId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "offsetMs": {
      "type": "integer",
      "minimum": -600000,
      "maximum": 0
    },
    "mimeType": {
      "type": "string",
      "const": "image/png"
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "expiresAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "snapshot",
    "frameId",
    "offsetMs",
    "mimeType",
    "width",
    "height",
    "contentHash",
    "expiresAtUtc"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aikernel:cosmos:scene-v1:media-registration",
  "description": "Wire shape. Cross-field authorization, catalog, snapshot, duplicate keys, byte limits and configured limits are additionally enforced by SceneService. See COSMOS_SCENE_P0.md."
}
