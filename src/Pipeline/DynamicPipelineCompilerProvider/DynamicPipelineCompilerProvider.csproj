<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>AIKernel.Providers.DynamicPipelineCompiler</Title>
    <PackageId>AIKernel.Providers.DynamicPipelineCompiler</PackageId>
    <Description>EN: Official AIKernel.NET extension provider for dynamic semantic pipeline compilation.

JA: 動的 semantic pipeline compile を AIKernel 上で扱うための AIKernel.NET 公式拡張 Provider です。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Common" Version="[$(AIKernelCorePackageVersion)]" />
    <PackageReference Include="AIKernel.Core" Version="[$(AIKernelCorePackageVersion)]" />
    <PackageReference Include="AIKernel.Abstractions" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="AIKernel.Dtos" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="AIKernel.Enums" Version="$(AIKernelPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="dynamic-pipeline.provider.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="providers\" />
  </ItemGroup>
</Project>
