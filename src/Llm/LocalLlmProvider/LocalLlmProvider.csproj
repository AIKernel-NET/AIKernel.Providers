<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>AIKernel.Providers.LocalLlm</Title>
    <PackageId>AIKernel.Providers.LocalLlm</PackageId>
    <Description>EN: Official AIKernel.NET extension provider for local LLM runtimes such as Ollama, llama.cpp, and vLLM.

JA: Ollama、llama.cpp、vLLM などの local LLM runtime を AIKernel 上で扱うための AIKernel.NET 公式拡張 Provider です。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Common" Version="[$(AIKernelCorePackageVersion)]" />
    <PackageReference Include="AIKernel.Core" Version="[$(AIKernelCorePackageVersion)]" />
    <PackageReference Include="AIKernel.Abstractions" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="AIKernel.Dtos" Version="$(AIKernelPackageVersion)" />
    <PackageReference Include="AIKernel.Enums" Version="$(AIKernelPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="local-llm.provider.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="providers\" />
  </ItemGroup>
</Project>
