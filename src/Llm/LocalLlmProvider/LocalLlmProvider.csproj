<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>AIKernel.Providers.LocalLlm</Title>
    <PackageId>AIKernel.Providers.LocalLlm</PackageId>
    <PackageVersion>0.1.5</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.5.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion>0.1.4</PackageValidationBaselineVersion>
    <PackageReleaseNotes>Returns a typed failure for unregistered embeddings. Register an embedding model with AIKernel.Providers.Embedding for real local embeddings.</PackageReleaseNotes>
    <Description>EN: Official AIKernel.NET extension provider for local LLM runtimes such as Ollama, llama.cpp, and vLLM.

JA: Ollama、llama.cpp、vLLM などの local LLM runtime を AIKernel 上で扱うための AIKernel.NET 公式拡張 Provider です。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Common" Version="[0.1.4]" />
    <PackageReference Include="AIKernel.Core" Version="[0.1.4]" />
    <PackageReference Include="AIKernel.Abstractions" Version="0.1.4" />
    <PackageReference Include="AIKernel.Dtos" Version="0.1.4" />
    <PackageReference Include="AIKernel.Enums" Version="0.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="local-llm.provider.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="providers\" />
  </ItemGroup>
</Project>
