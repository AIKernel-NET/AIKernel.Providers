<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>AIKernel.Providers.LocalLlm</Title>
    <PackageId>AIKernel.Providers.LocalLlm</PackageId>
    <PackageVersion>0.3.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion>0.1.6</PackageValidationBaselineVersion>
    <PackageReadmeFile>LOCAL-LLM.md</PackageReadmeFile>
    <PackageReleaseNotes>Connects chat.local to the AIKernel Kernel CPU engine for host-registered Bonsai GGUF weights.</PackageReleaseNotes>
    <Description>EN: Runs local Bonsai chat through the CPU inference engine in AIKernel 0.1.4.

JA: AIKernel 0.1.4のCPU推論エンジンでBonsaiとのローカルチャットを実行するProviderです。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Common" Version="[0.1.4]" />
    <PackageReference Include="AIKernel.Core" Version="[0.1.4]" />
    <ProjectReference Include="$(AIKernelKernelSourceProject)" Condition="'$(AIKernelKernelSourceProject)' != ''" />
    <PackageReference Include="AIKernel.Kernel" Version="[0.3.0]" Condition="'$(AIKernelKernelSourceProject)' == ''" />
    <PackageReference Include="Roslynator.Analyzers" Version="[5.0.1]" PrivateAssets="all" />
    <None Update="bonsai-1.7b.json;dense-profile-v1.schema.json" Pack="true" PackagePath="profiles/" />
    <EmbeddedResource Include="bonsai-1.7b.json" LogicalName="AIKernel.LocalLlm.BonsaiRegistration" />
    <PackageReference Include="AIKernel.Abstractions" Version="0.1.4" />
    <PackageReference Include="AIKernel.Dtos" Version="0.1.4" />
    <PackageReference Include="AIKernel.Enums" Version="0.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="local-llm.provider.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="providers\" />
    <None Include="docs/README.md" Pack="true" PackagePath="LOCAL-LLM.md" />
    <None Include="docs/README-ja.md" Pack="true" PackagePath="LOCAL-LLM-ja.md" />
  </ItemGroup>
</Project>
