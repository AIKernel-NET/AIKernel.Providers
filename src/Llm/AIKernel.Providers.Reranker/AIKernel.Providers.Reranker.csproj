<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageVersion>0.1.4</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageReadmeFile>RERANKER.md</PackageReadmeFile>
    <PackageTags>aikernel;reranker;onnx;multilingual;cpu</PackageTags>
    <Description>Local CPU text reranking with the pinned mMARCO MiniLM FP32 ONNX model.</Description>
    <PackageReleaseNotes>Adds cross-encoder relevance ranking with configurable limits and CPU threads.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Contracts.Reranking" Version="[0.1.4]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Tokenizers.HuggingFace" Version="3.23.1" />
    <None Update="RERANKER.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
