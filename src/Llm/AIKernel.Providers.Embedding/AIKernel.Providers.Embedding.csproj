<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageVersion>0.1.4</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageReadmeFile>EMBEDDING.md</PackageReadmeFile>
    <PackageTags>aikernel;embedding;onnx;multilingual;cpu</PackageTags>
    <Description>Local CPU multilingual text embeddings using the pinned multilingual-e5-small FP32 ONNX model.</Description>
    <PackageReleaseNotes>Adds real local text embeddings with configurable limits and AIKernel 0.1.4 text API compatibility.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Contracts.Embedding" Version="[0.1.4]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Tokenizers.HuggingFace" Version="3.23.1" />
    <None Update="EMBEDDING.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
