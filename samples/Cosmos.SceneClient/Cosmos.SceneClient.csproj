<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><IsPackable>false</IsPackable><GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(UseCosmosPackage)' == 'true'">package-consumer.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseCosmosPackage)' != 'true'">
    <ProjectReference Include="../../src/Cosmos/AIKernel.Providers.Cosmos/AIKernel.Providers.Cosmos.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCosmosPackage)' == 'true'">
    <PackageReference Include="AIKernel.Providers.Cosmos" Version="[0.1.4-dev9]" />
    <PackageReference Include="AIKernel.Common" Version="[0.1.3-dev1]" />
    <PackageReference Include="AIKernel.Core" Version="[0.1.3-dev1]" />
  </ItemGroup>
</Project>
